# Source files (bundled into dist/)
src/**
tsconfig.json

# Development and CI
.vscode/**
.github/**
.vscode-test/**
.cocoindex_code/**
.claude/**
.worktrees/**
.superpowers/**

# Documentation and samples
docs/**
work/**
sample/**

# images/ — VS Code extensions view fetches README images from GitHub (via
# vsce's URL rewriting). Only icon.png (extension logo) is read from the vsix.
images/**
!images/icon.png

# Test
test/**
tmp/

# Config and build artifacts
.eslintrc.json
*.vsix
*.bat
.gitignore
.codex
.vscode-test.mjs
CLAUDE.md
AGENTS.md

# Node modules - exclude all, then re-include needed packages
node_modules/**

# Runtime asset packages (only specific subdirectories needed at runtime)
!node_modules/emoji-images/pngs/
!node_modules/emoji-images/pngs/**
!node_modules/highlight.js/styles/
!node_modules/highlight.js/styles/**
